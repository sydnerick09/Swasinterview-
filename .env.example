# SWASTASK Application Portal — optional deploy-time configuration.
# All of these have sensible defaults. Copy to `.env.local` to override locally, or set
# them in Vercel → Project → Settings → Environment Variables for production.

# When the recruitment window opens (ISO 8601). Defaults to the first time the portal
# is opened in a given browser.
# NEXT_PUBLIC_OPEN_DATE=2026-08-01T09:00:00.000Z

# Duration of the recruitment window in days (default: 4).
# NEXT_PUBLIC_WINDOW_DAYS=4

# ---------------------------------------------------------------------------
# Pricing
# ---------------------------------------------------------------------------
# Fees are per-country: Kenya KES 200, England KES 7,000, Uganda in UGX (~KES 500),
# Tanzania in TZS (~KES 400), Burundi and all other countries in USD.
# These rates convert the Uganda/Tanzania KES equivalents into local currency.
NEXT_PUBLIC_KES_TO_UGX=29
NEXT_PUBLIC_KES_TO_TZS=20

# ---------------------------------------------------------------------------
# Paystack payments
# ---------------------------------------------------------------------------
# PUBLIC key — safe to expose in the browser. (Paste your pk_live_... / pk_test_... value.)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_YOUR_PUBLIC_KEY

# SECRET key — SERVER ONLY. Never commit this or prefix it with NEXT_PUBLIC_.
# Set it in Vercel → Project → Settings → Environment Variables. (Paste your sk_live_... value.)
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_SECRET_KEY

# Note: the charge currency is now derived per-country from the pricing rules above
# (KES, UGX, TZS or USD) so it always matches what the applicant is shown. Ensure the
# relevant currencies are enabled on your Paystack account.

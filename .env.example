# SWASTASK Application Portal — optional deploy-time configuration.
# All of these have sensible defaults. Copy to `.env.local` to override locally, or set
# them in Vercel → Project → Settings → Environment Variables for production.

# When the recruitment window opens (ISO 8601). Defaults to the first time the portal
# is opened in a given browser.
# NEXT_PUBLIC_OPEN_DATE=2026-08-01T09:00:00.000Z

# Duration of the recruitment window in days (default: 4).
# NEXT_PUBLIC_WINDOW_DAYS=4

# ---------------------------------------------------------------------------
# Pricing
# ---------------------------------------------------------------------------
# Fees are per-country: Kenya KES 320, England KES 7,000, Uganda in UGX (~KES 500),
# Tanzania in TZS (~KES 400), Burundi and all other countries in USD. Payment is via
# M-Pesa (KES only), so these rates convert each fee to its KES equivalent at checkout.
NEXT_PUBLIC_KES_TO_UGX=29
NEXT_PUBLIC_KES_TO_TZS=20
NEXT_PUBLIC_USD_TO_KES=130

# ---------------------------------------------------------------------------
# Safaricom Daraja — Lipa na M-Pesa Online (STK Push). SERVER ONLY (no NEXT_PUBLIC_).
# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

# Optional: secret token appended to the callback URL (?token=...) to reject spoofed callbacks.
DARAJA_CALLBACK_TOKEN=
# Optional: "CustomerPayBillOnline" (Paybill, default) or "CustomerBuyGoodsOnline" (Till).
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Flip to "true" once the Daraja credentials above are set (otherwise a demo pay button is shown).
NEXT_PUBLIC_MPESA_ENABLED=false
